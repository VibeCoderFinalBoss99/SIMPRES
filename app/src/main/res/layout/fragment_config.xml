<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <ImageView
            style="@style/IconButton"
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ink"
            android:contentDescription="@string/common_kembali"
            android:layout_gravity="center_vertical|start" />
        <TextView
            style="@style/T.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_konfigurasi"
            android:layout_gravity="center" />
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_round_primary">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_person"
                        android:tint="@color/primary_on_tint"
                        android:layout_gravity="center" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/config_nama_pegawai" />
                    <TextView
                        style="@style/T.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/config_shift_non_shift_petugas"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                style="@style/T.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_geofence_lokasi"
                android:layout_marginTop="26dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="0dp"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:id="@+id/rowResetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_lock"
                        android:tint="@color/ink_muted" />
                    <TextView
                        style="@style/T.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/config_reset_kata_sandi"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1" />
                </LinearLayout>
                <View
                    style="@style/Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />
                <LinearLayout
                    android:id="@+id/rowChangeInfo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_info"
                        android:tint="@color/ink_muted" />
                    <TextView
                        style="@style/T.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/config_ajukan_perubahan_informasi"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1" />
                </LinearLayout>
                <View
                    style="@style/Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_clipboard"
                        android:tint="@color/ink_muted" />
                    <TextView
                        style="@style/T.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/config_mode_tugas_lapangan"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swFieldMode"
                        android:layout_width="40dp"
                        android:layout_height="22dp"
                        android:checked="true"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">
        <Button
            style="@style/Button.Primary"
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/config_simpan_perubahan" />
    </LinearLayout>
</LinearLayout>
