<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_tile_primary_r18"
            android:layout_marginTop="24dp">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_location"
                android:tint="@color/primary"
                android:layout_gravity="center" />
        </FrameLayout>
        <TextView
            style="@style/T.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_masuk_ke_simpres"
            android:layout_marginTop="20dp" />
        <TextView
            style="@style/T.BodyMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_gunakan_akun_yang_dibuat"
            android:layout_marginTop="8dp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp">
            <TextView
                style="@style/T.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_nip_email" />
        </LinearLayout>
        <EditText
            style="@style/Input"
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/common_nur_aisyah_pkmsimbang_id"
            android:hint="@string/common_nip_atau_email"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_mail"
            android:inputType="textEmailAddress" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp">
            <TextView
                style="@style/T.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_kata_sandi" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                style="@style/Input"
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/login_text"
                android:hint="@string/common_kata_sandi"
                android:background="@drawable/bg_input_active"
                android:drawableStart="@drawable/ic_lock"
                android:inputType="textPassword"
                android:paddingEnd="52dp" />
            <ImageView
                android:id="@+id/btnTogglePassword"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_eye"
                android:tint="@color/ink_muted"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="15dp"
                android:contentDescription="@string/login_tampilkan_kata_sandi" />
        </FrameLayout>
        <TextView
            style="@style/T.Link"
            android:id="@+id/tvForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_lupa_kata_sandi"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="-8dp" />
        <Button
            style="@style/Button.Primary"
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/login_masuk"
            android:drawableStart="@drawable/ic_login"
            android:layout_marginTop="16dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_note_neutral"
            android:padding="14dp"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="24dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info"
                android:tint="@color/ink_muted" />
            <TextView
                style="@style/T.Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/login_belum_punya_akun_hubungi"
                android:layout_weight="1"
                android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
