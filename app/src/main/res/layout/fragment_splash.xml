<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">
    <View
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:background="@drawable/bg_ring"
        android:layout_gravity="top|start"
        android:layout_marginStart="-70dp"
        android:layout_marginTop="-44dp" />
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_ring"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-76dp"
        android:layout_marginBottom="-7dp" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center_horizontal">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieIntro"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:importantForAccessibility="no"
            app:lottie_rawRes="@raw/intro_simpres"
            app:lottie_autoPlay="false"
            app:lottie_loop="false" />
        <TextView
            android:id="@+id/tvAppName"
            style="@style/T.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_simpres"
            android:textSize="30sp"
            android:textColor="@color/white"
            android:fontFamily="@font/lexend_semibold"
            android:layout_marginTop="-40dp" />
        <View
            android:id="@+id/vGoldBar"
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:background="@color/gold"
            android:layout_marginTop="4dp" />
        <TextView
            style="@style/T.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvTagline"
            android:text="@string/common_sistem_presensi_simbang"
            android:textColor="@color/splash_text"
            android:layout_marginTop="8dp" />
    </LinearLayout>
    <TextView
        style="@style/T.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/splash_uptd_puskesmas_simbang_kabupaten"
        android:textColor="@color/splash_text"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:lineSpacingMultiplier="1.3" />
</FrameLayout>
