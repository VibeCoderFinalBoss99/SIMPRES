<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <ImageView
            style="@style/IconButton"
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ink"
            android:contentDescription="@string/common_kembali"
            android:layout_gravity="center_vertical|start" />
        <TextView
            style="@style/T.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_izin_cuti"
            android:layout_gravity="center" />
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/T.Label"
                        android:id="@+id/tabAll"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/common_semua"
                        android:background="@drawable/bg_pill"
                        android:textColor="@color/tab_text"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        style="@style/T.Label"
                        android:id="@+id/tabPending"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/common_menunggu"
                        android:background="@drawable/bg_pill"
                        android:textColor="@color/tab_text"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        style="@style/T.Label"
                        android:id="@+id/tabAccepted"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/common_diterima"
                        android:background="@drawable/bg_pill"
                        android:textColor="@color/tab_text"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        style="@style/T.Label"
                        android:id="@+id/tabRejected"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/common_ditolak"
                        android:background="@drawable/bg_pill"
                        android:textColor="@color/tab_text"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="6dp" />
                </LinearLayout>
            </HorizontalScrollView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginTop="16dp"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tile_primary">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_calendar"
                            android:tint="@color/primary_on_tint"
                            android:layout_gravity="center" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_gravity="center_vertical">
                        <TextView
                            style="@style/T.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_izin_keluar_jam_kerja" />
                        <TextView
                            style="@style/T.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/leave_list_rab_28_okt_2026"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    style="@style/T.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/leave_list_mengurus_berkas_bpjs_di"
                    android:textSize="13sp"
                    android:layout_marginTop="14dp" />
                <View
                    style="@style/Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">
                    <TextView
                        style="@style/T.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/leave_list_dikirim_28_okt_08"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_menunggu_konfirmasi"
                        android:background="@drawable/bg_chip_warn"
                        android:textColor="@color/warn_text" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/itemAccepted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginTop="14dp"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tile_primary">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_calendar"
                            android:tint="@color/primary_on_tint"
                            android:layout_gravity="center" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_gravity="center_vertical">
                        <TextView
                            style="@style/T.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_izin_sakit" />
                        <TextView
                            style="@style/T.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/leave_list_sensel_2627_okt_2026"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    style="@style/T.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/leave_list_demam_dan_flu_surat"
                    android:textSize="13sp"
                    android:layout_marginTop="14dp" />
                <View
                    style="@style/Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">
                    <TextView
                        style="@style/T.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/leave_list_disetujui_26_okt_09"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_diterima"
                        android:background="@drawable/bg_chip_success"
                        android:textColor="@color/success" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/itemRejected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginTop="14dp"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tile_primary">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_calendar"
                            android:tint="@color/primary_on_tint"
                            android:layout_gravity="center" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_gravity="center_vertical">
                        <TextView
                            style="@style/T.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_izin_keperluan_lain" />
                        <TextView
                            style="@style/T.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/leave_list_senin_20_okt_2026"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    style="@style/T.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_keperluan_keluarga_di_luar"
                    android:textSize="13sp"
                    android:layout_marginTop="14dp" />
                <View
                    style="@style/Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">
                    <TextView
                        style="@style/T.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/leave_list_diputuskan_20_okt_10"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_ditolak"
                        android:background="@drawable/bg_chip_danger"
                        android:textColor="@color/danger" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">
        <Button
            style="@style/Button.Primary"
            android:id="@+id/btnNew"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/common_ajukan_izin"
            android:drawableStart="@drawable/ic_add" />
    </LinearLayout>
</LinearLayout>
