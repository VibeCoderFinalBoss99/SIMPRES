<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <ImageView
            style="@style/IconButton"
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ink"
            android:contentDescription="@string/common_kembali"
            android:layout_gravity="center_vertical|start" />
        <TextView
            style="@style/T.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_detail_izin"
            android:layout_gravity="center" />
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginTop="8dp"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_tile_primary">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_medical"
                            android:tint="@color/primary_on_tint"
                            android:layout_gravity="center" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_gravity="center_vertical">
                        <TextView
                            style="@style/T.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_izin_sakit"
                            android:textSize="17sp" />
                        <TextView
                            style="@style/T.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/leave_accepted_diajukan_26_okt_2026"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <TextView
                        style="@style/T.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_diterima"
                        android:background="@drawable/bg_chip_success"
                        android:textColor="@color/success" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="22dp">
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_tanggal"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/leave_accepted_sensel_2627_okt_2026"
                        android:gravity="end" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/leave_accepted_durasi"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/leave_accepted_2_hari"
                        android:gravity="end" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_lampiran"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_surat_dokter_26okt_pdf"
                        android:textColor="@color/primary_on_tint"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView
                    style="@style/T.Key"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_alasan" />
                <TextView
                    style="@style/T.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_demam_dan_flu_sejak"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/lexend_regular" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView
                    style="@style/T.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_riwayat_status" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="14dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/primary"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp" />
                            <View
                                android:layout_width="2dp"
                                android:layout_height="0dp"
                                android:background="@color/border"
                                android:layout_weight="1"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="2dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:paddingBottom="14dp">
                            <TextView
                                style="@style/T.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_pengajuan_dikirim" />
                            <TextView
                                style="@style/T.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/leave_accepted_26_okt_2026_07"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="14dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/primary"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp" />
                            <View
                                android:layout_width="2dp"
                                android:layout_height="0dp"
                                android:background="@color/border"
                                android:layout_weight="1"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="2dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:paddingBottom="14dp">
                            <TextView
                                style="@style/T.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/leave_accepted_ditinjau_oleh_dr_hendra" />
                            <TextView
                                style="@style/T.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/leave_accepted_26_okt_2026_09"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="14dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/success"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:paddingBottom="0dp">
                            <TextView
                                style="@style/T.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_diterima" />
                            <TextView
                                style="@style/T.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/leave_accepted_26_okt_2026_09_2"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_note_success"
                android:padding="16dp"
                android:layout_marginTop="12dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_info"
                    android:tint="@color/success" />
                <TextView
                    style="@style/T.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/leave_accepted_absensi_tanggal_2627_okt"
                    android:textColor="@color/success_text"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">
        <Button
            style="@style/Button.Secondary"
            android:id="@+id/btnPrimary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/leave_accepted_kembali_ke_daftar_izin" />
    </LinearLayout>
</LinearLayout>
