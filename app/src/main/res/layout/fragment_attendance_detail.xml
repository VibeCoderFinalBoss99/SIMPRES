<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <ImageView
            style="@style/IconButton"
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ink"
            android:contentDescription="@string/common_kembali"
            android:layout_gravity="center_vertical|start" />
        <TextView
            style="@style/T.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/attendance_detail_detail_absensi"
            android:layout_gravity="center" />
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:padding="16dp">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_tile_teal">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_location"
                        android:tint="@color/teal_text"
                        android:layout_gravity="center" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical">
                    <TextView
                        style="@style/T.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_tugas_lapangan" />
                    <TextView
                        style="@style/T.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/attendance_detail_senin_26_okt_2026"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView
                    style="@style/T.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_perlu_review"
                    android:background="@drawable/bg_chip_teal"
                    android:textColor="@color/teal_text" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="152dp"
                android:background="@drawable/bg_map"
                android:layout_marginTop="14dp">
                <View
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_geofence_ok"
                    android:layout_gravity="center" />
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_location"
                    android:tint="@color/primary"
                    android:layout_gravity="center" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginTop="14dp"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="0dp">
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_lokasi"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/attendance_detail_desa_jenetaesa"
                        android:gravity="end" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_akurasi_gps"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/attendance_detail_12_m"
                        android:gravity="end" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_alasan"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/attendance_detail_posyandu_mawar"
                        android:gravity="end" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/attendance_detail_foto_bukti"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Value"
                        android:id="@+id/tvPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/attendance_detail_lihat_foto"
                        android:textColor="@color/primary_on_tint"
                        android:gravity="end" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_sinkronisasi"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/attendance_detail_terkirim_08_16"
                        android:textColor="@color/success"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginTop="14dp"
                android:padding="16dp">
                <TextView
                    style="@style/T.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_status" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="14dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/success"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp" />
                            <View
                                android:layout_width="2dp"
                                android:layout_height="0dp"
                                android:background="@color/border"
                                android:layout_weight="1"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="2dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:paddingBottom="14dp">
                            <TextView
                                style="@style/T.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/attendance_detail_terkirim_ke_server" />
                            <TextView
                                style="@style/T.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/attendance_detail_26_okt_08_16"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="14dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/teal"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:paddingBottom="0dp">
                            <TextView
                                style="@style/T.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/attendance_detail_menunggu_tinjauan_admin" />
                            <TextView
                                style="@style/T.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/attendance_detail_biasanya_diproses_di_hari"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
