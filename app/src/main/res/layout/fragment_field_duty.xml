<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <ImageView
            style="@style/IconButton"
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ink"
            android:contentDescription="@string/common_kembali"
            android:layout_gravity="center_vertical|start" />
        <TextView
            style="@style/T.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_tugas_lapangan"
            android:layout_gravity="center" />
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_note_teal"
                android:padding="16dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_info"
                    android:tint="@color/teal_text" />
                <TextView
                    style="@style/T.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/field_duty_untuk_pegawai_yang_langsung"
                    android:textColor="@color/teal_text"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textSize="12.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp">
                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_duty_jenis_tugas" />
            </LinearLayout>
            <TextView
                style="@style/Input"
                android:id="@+id/tvDutyType"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/field_duty_posyandu_desa_jenetaesa"
                android:background="@drawable/bg_input"
                android:drawableEnd="@drawable/ic_arrow_drop_down" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp">
                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_duty_nomor_surat_tugas" />
                <TextView
                    style="@style/T.Key"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_opsional"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
            <EditText
                style="@style/Input"
                android:id="@+id/etLetterNo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="@string/field_duty_contoh_094_pkm_smb"
                android:background="@drawable/bg_input" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp">
                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_duty_alasan_keterangan" />
            </LinearLayout>
            <EditText
                style="@style/Input.Multiline"
                android:id="@+id/etReason"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:text="@string/field_duty_pelayanan_imunisasi_dan_penimban"
                android:background="@drawable/bg_input" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp">
                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_duty_foto_bukti_kegiatan" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/boxPhoto"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:orientation="vertical"
                android:background="@drawable/bg_upload_tint"
                android:gravity="center">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_camera"
                    android:tint="@color/primary_on_tint" />
                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_duty_ambil_foto_dengan_kamera"
                    android:textColor="@color/primary_on_tint"
                    android:layout_marginTop="8dp" />
                <TextView
                    style="@style/T.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_duty_foto_dari_galeri_tidak"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:layout_marginTop="14dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center_vertical"
                android:padding="16dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_location"
                    android:tint="@color/primary_on_tint" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp">
                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/field_duty_desa_jenetaesa_simbang" />
                    <TextView
                        style="@style/T.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/field_duty_5_0671_119_6935"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">
        <Button
            style="@style/Button.Primary"
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/field_duty_kirim_untuk_ditinjau" />
    </LinearLayout>
</LinearLayout>
