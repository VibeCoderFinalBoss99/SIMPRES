<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <ImageView
            style="@style/IconButton"
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ink"
            android:contentDescription="@string/common_kembali"
            android:layout_gravity="center_vertical|start" />
        <TextView
            style="@style/T.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_tentang_aplikasi"
            android:layout_gravity="center" />
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_logo"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="36dp">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_location"
                    android:tag="drop"
                    android:tint="@color/white"
                    android:layout_gravity="center" />
            </FrameLayout>
            <TextView
                style="@style/T.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_simpres"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp" />
            <TextView
                style="@style/T.BodyMuted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_sistem_presensi_simbang"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginTop="32dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="0dp">
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/about_versi"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_1_0_0_build"
                        android:gravity="end" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/about_pengembang"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_kelompok_4_pnup"
                        android:gravity="end" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/about_mitra"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_uptd_puskesmas_simbang"
                        android:gravity="end" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/about_pembaruan"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_28_okt_2026"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">
        <TextView
            style="@style/T.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_2026_uptd_puskesmas_simbang"
            android:textSize="11.5sp"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
