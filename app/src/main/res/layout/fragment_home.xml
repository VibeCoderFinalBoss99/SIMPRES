<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:background="@color/bg">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="14dp">
                    <LinearLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_round_primary"
                        android:gravity="center">
                        <TextView
                            style="@style/T.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_na"
                            android:textColor="@color/primary_on_tint"
                            android:textSize="17sp"
                            android:layout_gravity="center" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:layout_gravity="center_vertical">
                        <TextView
                            style="@style/T.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_nur_aisyah"
                            android:textSize="19sp" />
                        <TextView
                            style="@style/T.Key"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_perawat_poli_umum"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/btnBell"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_btn">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_bell"
                            android:tag="ring"
                            android:tint="@color/ink"
                            android:layout_gravity="center" />
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/danger"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="13dp"
                            android:layout_marginEnd="13dp" />
                    </FrameLayout>
                </LinearLayout>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="20dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingEnd="20dp"
                        android:paddingStart="10dp">
                        <LinearLayout
                            android:layout_width="64dp"
                            android:layout_height="70dp"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_day"
                            android:gravity="center">
                            <TextView
                                style="@style/T.Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_26"
                                android:textSize="18sp"
                                android:textColor="@color/ink" />
                            <TextView
                                style="@style/T.Key"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_sen"
                                android:textColor="@color/ink_muted"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="64dp"
                            android:layout_height="70dp"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_day"
                            android:gravity="center">
                            <TextView
                                style="@style/T.Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_27"
                                android:textSize="18sp"
                                android:textColor="@color/ink" />
                            <TextView
                                style="@style/T.Key"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_sel"
                                android:textColor="@color/ink_muted"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="64dp"
                            android:layout_height="70dp"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_day_on"
                            android:gravity="center">
                            <TextView
                                style="@style/T.Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_28"
                                android:textSize="18sp"
                                android:textColor="@color/white" />
                            <TextView
                                style="@style/T.Key"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_rab"
                                android:textColor="@color/white"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="64dp"
                            android:layout_height="70dp"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_day"
                            android:gravity="center">
                            <TextView
                                style="@style/T.Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_29"
                                android:textSize="18sp"
                                android:textColor="@color/ink" />
                            <TextView
                                style="@style/T.Key"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_kam"
                                android:textColor="@color/ink_muted"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="64dp"
                            android:layout_height="70dp"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_day"
                            android:gravity="center">
                            <TextView
                                style="@style/T.Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_30"
                                android:textSize="18sp"
                                android:textColor="@color/ink" />
                            <TextView
                                style="@style/T.Key"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_jum"
                                android:textColor="@color/ink_muted"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        style="@style/T.Subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/home_absensi_hari_ini"
                        android:textSize="16sp"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_non_shift_07_0014"
                        android:background="@drawable/bg_chip_primary"
                        android:textColor="@color/primary_on_tint" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:layout_weight="1"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_tile_primary">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_clock"
                                    android:tint="@color/primary_on_tint"
                                    android:layout_gravity="center" />
                            </FrameLayout>
                            <TextView
                                style="@style/T.Key"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_check_in"
                                android:layout_marginStart="10dp" />
                        </LinearLayout>
                        <TextView
                            style="@style/T.TitleL"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_08_02"
                            android:textColor="@color/ink"
                            android:layout_marginTop="12dp" />
                        <TextView
                            style="@style/T.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_tepat_waktu"
                            android:layout_marginTop="2dp"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                    <View android:layout_width="12dp" android:layout_height="0dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:layout_weight="1"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_tile_primary">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_clock"
                                    android:tint="@color/primary_on_tint"
                                    android:layout_gravity="center" />
                            </FrameLayout>
                            <TextView
                                style="@style/T.Key"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_check_out"
                                android:layout_marginStart="10dp" />
                        </LinearLayout>
                        <TextView
                            style="@style/T.TitleL"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_text"
                            android:textColor="@color/ink"
                            android:layout_marginTop="12dp" />
                        <TextView
                            style="@style/T.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_batas_15_00"
                            android:layout_marginTop="2dp"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:layout_weight="1"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_tile_primary">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_location"
                                    android:tint="@color/primary_on_tint"
                                    android:layout_gravity="center" />
                            </FrameLayout>
                            <TextView
                                style="@style/T.Key"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_lokasi"
                                android:layout_marginStart="10dp" />
                        </LinearLayout>
                        <TextView
                            style="@style/T.TitleL"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_42_m"
                            android:textColor="@color/ink"
                            android:layout_marginTop="12dp" />
                        <TextView
                            style="@style/T.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_di_dalam_area"
                            android:layout_marginTop="2dp"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                    <View android:layout_width="12dp" android:layout_height="0dp" />
                    <LinearLayout
                        android:id="@+id/cardSync"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:layout_weight="1"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_tile_primary">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_sync"
                                    android:tint="@color/primary_on_tint"
                                    android:layout_gravity="center" />
                            </FrameLayout>
                            <TextView
                                style="@style/T.Key"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_sinkronisasi"
                                android:layout_marginStart="10dp" />
                        </LinearLayout>
                        <TextView
                            style="@style/T.TitleL"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_aman"
                            android:textColor="@color/ink"
                            android:layout_marginTop="12dp" />
                        <TextView
                            style="@style/T.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_semua_terkirim"
                            android:layout_marginTop="2dp"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical">
                    <TextView
                        style="@style/T.Subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/home_aktivitas_kamu"
                        android:textSize="16sp"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/T.Key"
                        android:id="@+id/tvSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_lihat_semua"
                        android:textColor="@color/primary_on_tint"
                        android:padding="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginTop="12dp">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tile_primary">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_check_circle"
                            android:tint="@color/primary_on_tint"
                            android:layout_gravity="center" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_gravity="center_vertical">
                        <TextView
                            style="@style/T.Item"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_check_in" />
                        <TextView
                            style="@style/T.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_28_okt_2026"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnCheckOut"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_swipe"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:layout_marginTop="14dp">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_swipe_knob">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_arrow_forward"
                            android:tint="@color/white"
                            android:layout_gravity="center" />
                    </FrameLayout>
                    <TextView
                        style="@style/T.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/home_geser_untuk_check_out"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/view_bottom_nav" />
</LinearLayout>
