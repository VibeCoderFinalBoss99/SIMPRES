<?xml version="1.0" encoding="utf-8"?>
<!--
    Beranda: kepala biru (logo, lonceng, salam), kartu Presensi Hari Ini (jam masuk/pulang + tombol geser),
    menu cepat (Izin & Cuti, Koreksi), Rekapitulasi bulan ini, dan Informasi Pegawai.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:overScrollMode="never">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <!-- Latar biru di belakang kepala dan separuh atas kartu presensi. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:background="@drawable/bg_home_header" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">
                <!-- Logo dan nama aplikasi, lonceng notifikasi. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="16dp">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@mipmap/ic_launcher_round"
                        android:contentDescription="@string/common_simpres" />
                    <!-- Hanya logo dan lonceng, tanpa tulisan nama aplikasi (lebih bersih). -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <FrameLayout
                        android:id="@+id/btnBell"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_glass_round"
                        android:contentDescription="@string/common_notifikasi">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_bell"
                            android:tag="ring"
                            android:tint="@color/white"
                            android:layout_gravity="center" />
                        <!-- Titik merah hanya tampil jika ada notifikasi yang belum dibaca. -->
                        <View
                            android:id="@+id/bellDot"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:visibility="gone"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/danger"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="11dp"
                            android:layout_marginEnd="11dp" />
                    </FrameLayout>
                </LinearLayout>
                <!-- Salam dan nama pegawai. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="18dp">
                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_glass_round"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvAvatar"
                            style="@style/T.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:id="@+id/tvGreeting"
                            style="@style/T.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#E6FFFFFF" />
                        <TextView
                            android:id="@+id/tvName"
                            style="@style/T.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="@color/white" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Presensi Hari Ini: tanggal, shift, jam masuk/pulang, tombol geser. -->
                <LinearLayout
                    android:id="@+id/gridToday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:elevation="3dp"
                    android:layout_marginTop="20dp"
                    android:padding="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/T.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_today_title" />
                            <TextView
                                android:id="@+id/tvTodayDate"
                                style="@style/T.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink_muted" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvShift"
                            style="@style/T.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_primary"
                            android:textColor="@color/primary_on_tint" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_time_box"
                            android:padding="12dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <FrameLayout
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/bg_round_success">
                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_login"
                                        android:tint="@color/success"
                                        android:layout_gravity="center" />
                                </FrameLayout>
                                <TextView
                                    style="@style/T.Small"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/home_jam_masuk"
                                    android:textColor="@color/ink_muted" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tvCheckInTime"
                                style="@style/T.Headline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="--.--" />
                            <TextView
                                android:id="@+id/tvCheckInStatus"
                                style="@style/T.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink_muted" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_time_box"
                            android:layout_marginStart="10dp"
                            android:padding="12dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <FrameLayout
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/bg_round_warn">
                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_logout"
                                        android:tint="@color/warn"
                                        android:layout_gravity="center" />
                                </FrameLayout>
                                <TextView
                                    style="@style/T.Small"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/home_jam_pulang"
                                    android:textColor="@color/ink_muted" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tvCheckOutTime"
                                style="@style/T.Headline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="--.--" />
                            <TextView
                                android:id="@+id/tvCheckOutNote"
                                style="@style/T.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink_muted" />
                        </LinearLayout>
                    </LinearLayout>
                    <!-- Antrean offline: tampil hanya jika ada absensi yang belum terkirim. -->
                    <LinearLayout
                        android:id="@+id/cardSync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_note_warn"
                        android:layout_marginTop="12dp"
                        android:padding="10dp"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_sync"
                            android:tint="@color/warn" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:id="@+id/tvSyncTitle"
                                style="@style/T.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                            <TextView
                                android:id="@+id/tvSyncNote"
                                style="@style/T.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink_muted" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/ink_faint" />
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/swipeCheckOut"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_swipe"
                        android:padding="8dp"
                        android:layout_marginTop="14dp"
                        android:contentDescription="@string/home_geser_untuk_check_in">
                        <TextView
                            android:id="@+id/tvSwipeLabel"
                            style="@style/T.Body"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/home_geser_untuk_check_in"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:paddingStart="40dp"
                            android:gravity="center"
                            android:importantForAccessibility="no" />
                        <FrameLayout
                            android:id="@+id/swipeKnob"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|start"
                            android:background="@drawable/bg_swipe_knob">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_arrow_forward"
                                android:tint="@color/white"
                                android:layout_gravity="center" />
                        </FrameLayout>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/tvDoneToday"
                        style="@style/T.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:visibility="gone"
                        android:background="@drawable/bg_note_success"
                        android:padding="12dp"
                        android:textColor="@color/success_text"
                        android:text="@string/home_done_today" />
                </LinearLayout>

                <!-- Menu cepat. -->
                <LinearLayout
                    android:id="@+id/quickActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:id="@+id/btnLeave"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_card"
                        android:padding="14dp">
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_round_primary">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_calendar"
                                android:tint="@color/primary_on_tint"
                                android:layout_gravity="center" />
                        </FrameLayout>
                        <TextView
                            style="@style/T.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="@string/home_menu_leave" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/btnCorrection"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_card"
                        android:layout_marginStart="10dp"
                        android:padding="14dp">
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_round_warn">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_clock"
                                android:tint="@color/warn"
                                android:layout_gravity="center" />
                        </FrameLayout>
                        <TextView
                            style="@style/T.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="@string/home_menu_correction" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Rekapitulasi bulan ini. -->
                <LinearLayout
                    android:id="@+id/cardRecap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:layout_marginTop="16dp"
                    android:padding="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/T.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_recap_title"
                                android:textColor="@color/ink_muted"
                                android:letterSpacing="0.08" />
                            <TextView
                                android:id="@+id/tvRecapMonth"
                                style="@style/T.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvSeeAll"
                            style="@style/T.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_lihat_semua" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/recapRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp" />
                </LinearLayout>

                <!-- Informasi pegawai. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:layout_marginTop="16dp"
                    android:padding="18dp">
                    <TextView
                        style="@style/T.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_info_title" />
                    <LinearLayout
                        android:id="@+id/infoList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
    <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/view_bottom_nav" />
</LinearLayout>
