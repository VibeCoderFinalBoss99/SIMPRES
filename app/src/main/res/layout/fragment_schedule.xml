<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:gravity="center_vertical">
        <TextView
            style="@style/T.TitleL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/schedule_jadwal_kerja"
            android:layout_weight="1" />
        <TextView
            style="@style/T.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_okt_2026"
            android:textColor="@color/primary_on_tint" />
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_drop_down"
            android:tint="@color/primary_on_tint" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="-3dp"
                android:layout_marginEnd="-3dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_week"
                    android:gravity="center_horizontal"
                    android:paddingTop="13dp">
                    <TextView
                        style="@style/T.Caps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_sen"
                        android:textSize="11sp"
                        android:textColor="@color/ink_muted" />
                    <TextView
                        style="@style/T.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_26"
                        android:textSize="16sp"
                        android:textColor="@color/ink"
                        android:layout_marginTop="4dp" />
                    <View
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/success"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_week"
                    android:gravity="center_horizontal"
                    android:paddingTop="13dp">
                    <TextView
                        style="@style/T.Caps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_sel"
                        android:textSize="11sp"
                        android:textColor="@color/ink_muted" />
                    <TextView
                        style="@style/T.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_27"
                        android:textSize="16sp"
                        android:textColor="@color/ink"
                        android:layout_marginTop="4dp" />
                    <View
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/success"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_week_on"
                    android:gravity="center_horizontal"
                    android:paddingTop="13dp">
                    <TextView
                        style="@style/T.Caps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_rab"
                        android:textSize="11sp"
                        android:textColor="@color/splash_text" />
                    <TextView
                        style="@style/T.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_28"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:layout_marginTop="4dp" />
                    <View
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/white"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_week"
                    android:gravity="center_horizontal"
                    android:paddingTop="13dp">
                    <TextView
                        style="@style/T.Caps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_kam"
                        android:textSize="11sp"
                        android:textColor="@color/ink_muted" />
                    <TextView
                        style="@style/T.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_29"
                        android:textSize="16sp"
                        android:textColor="@color/ink"
                        android:layout_marginTop="4dp" />
                    <View android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_week"
                    android:gravity="center_horizontal"
                    android:paddingTop="13dp">
                    <TextView
                        style="@style/T.Caps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_jum"
                        android:textSize="11sp"
                        android:textColor="@color/ink_muted" />
                    <TextView
                        style="@style/T.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_30"
                        android:textSize="16sp"
                        android:textColor="@color/ink"
                        android:layout_marginTop="4dp" />
                    <View android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_week"
                    android:gravity="center_horizontal"
                    android:paddingTop="13dp">
                    <TextView
                        style="@style/T.Caps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schedule_sab"
                        android:textSize="11sp"
                        android:textColor="@color/ink_muted" />
                    <TextView
                        style="@style/T.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schedule_31"
                        android:textSize="16sp"
                        android:textColor="@color/ink"
                        android:layout_marginTop="4dp" />
                    <View android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_week"
                    android:gravity="center_horizontal"
                    android:paddingTop="13dp">
