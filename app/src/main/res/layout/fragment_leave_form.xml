<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <ImageView
            style="@style/IconButton"
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ink"
            android:contentDescription="@string/common_kembali"
            android:layout_gravity="center_vertical|start" />
        <TextView
            style="@style/T.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_ajukan_izin"
            android:layout_gravity="center" />
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">
            <TextView
                style="@style/T.Item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/leave_form_jenis_izin"
                android:layout_marginTop="8dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView
                    style="@style/Option"
                    android:id="@+id/chipOut"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/leave_form_keluar_jam_kerja" />
                <TextView
                    style="@style/Option"
                    android:id="@+id/chipSick"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/leave_form_sakit"
                    android:layout_marginStart="8dp" />
                <TextView
                    style="@style/Option"
                    android:id="@+id/chipOther"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/common_lainnya"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/groupOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_tanggal" />
                </LinearLayout>
                <EditText
                    style="@style/Input"
                    android:id="@+id/etDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/leave_form_rabu_28_oktober_2026"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@drawable/ic_calendar" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="8dp">
                            <TextView
                                style="@style/T.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/leave_form_jam_keluar" />
                        </LinearLayout>
                        <EditText
                            style="@style/Input"
                            android:id="@+id/etFrom"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/leave_form_10_00_wita"
                            android:background="@drawable/bg_input"
                            android:drawableStart="@drawable/ic_clock" />
                    </LinearLayout>
                    <View android:layout_width="16dp" android:layout_height="0dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="8dp">
                            <TextView
                                style="@style/T.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/leave_form_jam_kembali" />
                        </LinearLayout>
                        <EditText
                            style="@style/Input"
                            android:id="@+id/etTo"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/leave_form_11_30_wita"
                            android:background="@drawable/bg_input"
                            android:drawableStart="@drawable/ic_clock" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_alasan" />
                </LinearLayout>
                <EditText
                    style="@style/Input.Multiline"
                    android:id="@+id/etReason"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:text="@string/leave_form_mengurus_berkas_bpjs_di"
                    android:background="@drawable/bg_input" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_lampiran" />
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_opsional"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowAttach"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_upload_row"
                    android:gravity="center_horizontal|center_vertical">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_attach"
                        android:tint="@color/primary_on_tint" />
                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_tambah_lampiran"
                        android:textColor="@color/primary_on_tint"
                        android:layout_marginStart="10dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_note_warn"
                    android:padding="16dp"
                    android:layout_marginTop="16dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_info"
                        android:tint="@color/warn_text" />
                    <TextView
                        style="@style/T.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/leave_form_izin_keluar_jam_kerja"
                        android:textColor="@color/warn_ink"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/groupSick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="8dp">
                            <TextView
                                style="@style/T.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/leave_form_tanggal_mulai" />
                        </LinearLayout>
                        <EditText
                            style="@style/Input"
                            android:id="@+id/etStart"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/leave_form_26_okt_2026"
                            android:background="@drawable/bg_input"
                            android:drawableStart="@drawable/ic_calendar" />
                    </LinearLayout>
                    <View android:layout_width="16dp" android:layout_height="0dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="8dp">
                            <TextView
                                style="@style/T.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/leave_form_tanggal_selesai" />
                        </LinearLayout>
                        <EditText
                            style="@style/Input"
                            android:id="@+id/etEnd"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/leave_form_27_okt_2026"
                            android:background="@drawable/bg_input"
                            android:drawableStart="@drawable/ic_calendar" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/leave_form_keluhan_alasan" />
                </LinearLayout>
                <EditText
                    style="@style/Input.Multiline"
                    android:id="@+id/etComplaint"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:text="@string/common_demam_dan_flu_sejak"
                    android:background="@drawable/bg_input" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        style="@style/T.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/leave_form_surat_keterangan_dokter" />
                    <TextView
                        style="@style/T.Key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/leave_form_wajib_jika_1_hari"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:padding="14dp">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tile_primary">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_file"
                            android:tint="@color/primary_on_tint"
                            android:layout_gravity="center" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp">
                        <TextView
                            style="@style/T.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_surat_dokter_26okt_pdf" />
                        <TextView
                            style="@style/T.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/leave_form_214_kb_terunggah"
                            android:textColor="@color/success"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/btnRemoveFile"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_close"
                        android:tint="@color/ink_muted"
                        android:contentDescription="@string/leave_form_hapus_lampiran" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_note_primary"
                    android:padding="16dp"
                    android:layout_marginTop="16dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_info"
                        android:tint="@color/primary_on_tint" />
                    <TextView
                        style="@style/T.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/leave_form_izin_sakit_lebih_dari"
                        android:textColor="@color/navy"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">
        <Button
            style="@style/Button.Primary"
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/common_kirim_pengajuan" />
    </LinearLayout>
</LinearLayout>
