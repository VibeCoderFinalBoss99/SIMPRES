<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text -->
    <style name="T">
        <item name="android:fontFamily">@font/lexend_light</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="T.Display" parent="T">
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="android:textSize">26sp</item>
    </style>
    <style name="T.Headline" parent="T">
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="T.TitleL" parent="T">
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="T.Title" parent="T">
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="T.Subtitle" parent="T">
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="T.Item" parent="T">
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="T.Body" parent="T">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="T.BodyMuted" parent="T.Body">
        <item name="android:textColor">@color/ink_muted</item>
    </style>
    <style name="T.Label" parent="T">
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="T.Key" parent="T">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>
    <style name="T.Value" parent="T.Label" />
    <style name="T.Small" parent="T">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>
    <style name="T.Section" parent="T.Label">
        <item name="android:textColor">@color/ink_muted</item>
    </style>
    <style name="T.Caps" parent="T">
        <item name="android:fontFamily">@font/lexend_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="T.Chip" parent="T">
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>
    <style name="T.Link" parent="T.Item">
        <item name="android:textColor">@color/primary</item>
        <item name="android:padding">8dp</item>
    </style>
    <style name="T.Nav" parent="T">
        <item name="android:fontFamily">@font/lexend_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ink_faint</item>
    </style>

    <!-- Buttons -->
    <style name="Button" parent="T">
        <item name="android:fontFamily">@font/lexend_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="Button.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:drawableTint">@color/white</item>
    </style>
    <style name="Button.Secondary">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/primary_on_tint</item>
        <item name="android:drawableTint">@color/primary_on_tint</item>
    </style>
    <style name="Button.Tint">
        <item name="android:background">@drawable/bg_btn_tint</item>
        <item name="android:textColor">@color/primary_on_tint</item>
        <item name="android:drawableTint">@color/primary_on_tint</item>
    </style>
    <style name="Button.Disabled">
        <item name="android:background">@drawable/bg_btn_disabled</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:drawableTint">@color/ink_muted</item>
        <item name="android:enabled">false</item>
    </style>
    <style name="Button.DangerOutline">
        <item name="android:background">@drawable/bg_btn_danger_outline</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:drawableTint">@color/danger</item>
    </style>
    <style name="Button.Danger">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Inputs -->
    <style name="Input" parent="T">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColorHint">@color/ink_faint</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/ink_muted</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Input.Multiline">
        <item name="android:gravity">top|start</item>
        <item name="android:inputType">textMultiLine</item>
        <item name="android:maxLines">6</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Misc -->
    <style name="IconButton">
        <item name="android:background">@drawable/bg_icon_btn</item>
        <item name="android:padding">9dp</item>
        <item name="android:tint">@color/ink</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="Divider">
        <item name="android:background">@color/divider</item>
    </style>
    <style name="Option" parent="T">
        <item name="android:background">@drawable/bg_option</item>
        <item name="android:textColor">@color/option_text</item>
        <item name="android:fontFamily">@font/lexend_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
